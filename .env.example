# Copie ce fichier en .env et remplis-le. Ne le commite jamais.

# --- fal.ai (génération images, vidéos, upscale, lip-sync) -----------------
# Clé sur https://fal.ai/dashboard/keys
# Sans clé, tout tourne en simulation (aucune dépense).
FAL_KEY=
# Force la simulation même avec une clé (1) — pratique pour tester
RIOT_FAL_MOCK=0

# --- Autres fournisseurs vidéo (facultatifs) --------------------------------
# Chaque clé ajoutée rend les offres du fournisseur disponibles au routage.
# Le détail (où créer la clé, prix, limites) est dans docs/FOURNISSEURS.md.
# Google Cloud, Vertex AI (Veo 3.1, payable par les 300 $ de l'essai Google Cloud)
VERTEX_PROJECT=
VERTEX_API_KEY=
# ou, à la place de VERTEX_API_KEY, le chemin du JSON d'un compte de service :
GOOGLE_APPLICATION_CREDENTIALS=
# Kling AI, API officielle (clé créée sur kling.ai, console développeur)
KLING_API_KEY=
# Runway (dev.runwayml.com) : Veo, Kling, Seedance, Wan, Hailuo, Grok Imagine
RUNWAYML_API_SECRET=
# Google Gemini API (aistudio.google.com) : Gemini Omni Flash
GEMINI_API_KEY=

# --- Telegram (notifications) ----------------------------------------------
# Bot créé avec @BotFather, puis ton identifiant de conversation (voir README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Régie -----------------------------------------------------------------
# Adresse utilisée dans les notifications : ton nom de machine Tailscale
RIOT_REGIE_URL=http://riot-pc:8420
RIOT_REGIE_PORT=8420
# Écoute sur toutes les interfaces ; mets l'IP Tailscale (100.x.y.z) pour
# n'être joignable QUE par Tailscale
RIOT_REGIE_HOST=0.0.0.0
# Optionnel : mot de passe d'accès (première visite avec ?token=...)
RIOT_REGIE_TOKEN=

# --- Agents Claude Code ------------------------------------------------------
# Le worker lance `claude -p "/prod <clip>"` avec ton abonnement Claude.
# NE METS PAS ANTHROPIC_API_KEY dans l'environnement : Claude Code facturerait
# l'API au lieu d'utiliser l'abonnement (le worker la retire par sécurité).
RIOT_AGENTS_ENABLED=1
RIOT_CLAUDE_BIN=claude
# Modèle de l'orchestrateur (vide = défaut de Claude Code). Les sous-agents
# ont leur propre modèle dans .claude/agents/*.md
RIOT_CLAUDE_MODEL=
# Durée max d'un passage d'agent (s) et attente avant de réessayer un clip bloqué (s)
RIOT_AGENT_TIMEOUT=2400
RIOT_AGENT_BACKOFF=600

# --- Divers ------------------------------------------------------------------
RIOT_POLL_SECONDS=30
# RIOT_STUDIO_ROOT=/chemin/vers/studio   (défaut : ./studio)
